# Virtual environments
venv/
.venv/
env/
ENV/

# Rust build artifacts
**/target/
**/*.rs.bk

# Python cache & compiled bytecode
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
pytest-cache-files-*/
src/*.egg-info/
.coverage
htmlcov/

# Node modules & npm
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS and IDE files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Runtime logs, data, and cache
logs/
*.log
screenpipe-data/
data/
recordings/
backups/
tmp/
private/
cache/
.lva_write_probe_*

# Large binaries, models, and executables
models/
# 	ools/* rather than 	ools/: a bare directory exclusion stops git from
# descending, so the negations below could never take effect.
tools/*
# The codegen sources are part of the deliverable, not build output.
!tools/codegen-rust/
!tools/codegen-rust/**
tools/codegen-rust/target/
*.gguf
*.exe
*.dll
*.o
*.obj
*.pdb
*.lib
*.a
!apps/desktop-shell/src-tauri/WebView2Loader.dll

# User runtime configuration & secrets
settings.json
services.json
user_profile.json

# Frontend build output (regenerated by `npm run build`)
apps/desktop-ui/dist/

# Regenerable run artifacts from soak / release gates
scripts/soak_report.json
scripts/temp_soak_journal.sqlite3
soak_smoke_report.json
release_soak_report.json

