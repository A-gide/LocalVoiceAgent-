{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lva-pet",
  "version": "0.1.0",
  "identifier": "com.lva.pet",
  "build": {
    "frontendDist": "../../desktop-ui/dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "services.default.json",
      "settings.default.json",
      "WebView2Loader.dll"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": false
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "installerHooks": "hooks.nsh"
      }
    }
  }
}
